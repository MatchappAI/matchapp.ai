# =============================================================================
# MatchAI — Environment Variables Template
# Copy to `.env` (and `.dev.vars` for Cloudflare Workers dev) and fill in real
# values. Never commit real secrets. Values marked (public) are safe to expose
# to the browser via VITE_*; everything else is server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage). Currently hosted by Lovable Cloud.
# To leave Lovable: either (a) migrate to a self-owned Supabase project and
# replace all six values, or (b) keep the same project and take over billing.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx           # anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=                             # server-only, required for admin writes / cron
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# -----------------------------------------------------------------------------
# Lovable-managed services (see docs/LOVABLE_EXIT_CHECKLIST.md for replacements)
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=                                       # AI gateway + MCP; replace with direct OpenAI/Google key when leaving Lovable
OPENAI_API_KEY=                                        # Optional direct fallback if replacing Lovable AI gateway
GOOGLE_GENERATIVE_AI_API_KEY=                          # Optional direct fallback (Gemini)

# -----------------------------------------------------------------------------
# Stripe (subscriptions + Connect payouts + escrow)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                        # signing secret for /api/public/stripe-webhook
STRIPE_CONNECT_CLIENT_ID=ca_xxx                        # for creator payout onboarding
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxx                                  # transactional + digest email
GMAIL_OAUTH_CLIENT_ID=                                 # Gmail send-as for creator outbound
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://your-domain.com/api/gmail/callback

# -----------------------------------------------------------------------------
# Scraping / enrichment
# -----------------------------------------------------------------------------
APIFY_TOKEN=                                           # brand + creator enrichment

# -----------------------------------------------------------------------------
# Cron / webhook shared secrets (compare with header on inbound calls)
# -----------------------------------------------------------------------------
CRON_SECRET=                                           # gate for /api/public/hooks/*
WEBHOOK_SHARED_SECRET=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
VITE_APP_URL=https://www.matchapp.ai                   # canonical URL used in emails/OAuth callbacks
NODE_ENV=development
